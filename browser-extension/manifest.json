{
  "manifest_version": 3,
  "name": "Bookmarks",
  "version": "2.0.0",
  "description": "Save the page you are reading to your self-hosted bookmarks server",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_icon": {
      "16": "icons/bookmark-16.png",
      "32": "icons/bookmark-32.png",
      "48": "icons/bookmark-48.png"
    },
    "default_title": "Save to Bookmarks",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{fe016f96-aeea-4b14-ae11-c2904e12a70f}",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "48": "icons/bookmark-48.png",
    "96": "icons/bookmark-96.png"
  }
}
