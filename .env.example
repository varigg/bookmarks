# Bookmarks Application Configuration
# Copy this file to .env and customize as needed

# Data Source
# Path to the bookmarks data file (relative or absolute)
BOOKMARKS_DATA_SOURCE=bookmarks.js

# Server Settings
# Flask secret key for session management (leave empty for auto-generated)
BOOKMARKS_SECRET_KEY=

# Enable debug mode for development
BOOKMARKS_DEBUG=false

# Port number for the server
BOOKMARKS_PORT=5001

# Backup Configuration
# Enable automatic backups on startup
BOOKMARKS_BACKUP_ENABLED=true

# Directory to store backup files (relative or absolute)
BOOKMARKS_BACKUP_DIR=backup

# Number of backups to keep (0 = unlimited, older backups are deleted)
BOOKMARKS_BACKUP_COUNT=5

# LLM Integration (Optional)
# Configure at least one LLM provider for auto-generating titles and descriptions

# Perplexity API (recommended for speed and cost)
# Get your API key from https://www.perplexity.ai/
PERPLEXITY_API_KEY=

# OpenAI API (optional, for GPT models)
# Get your API key from https://platform.openai.com/
OPENAI_API_KEY=

# Anthropic API (optional, for Claude models)
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
