# Non-secret settings for bookmarks. Copy to ~/.config/bookmarks/env and edit.
# Plain KEY=value lines only: systemd reads this as an EnvironmentFile and the
# cron entries source it. Secrets (tokens) belong elsewhere, not here.
BOOKMARKS_OLLAMA_URL=http://localhost:11434
BOOKMARKS_BACKUP_DIR=/path/to/existing/backup/directory
BOOKMARKS_ALERT_TO=you@example.com
