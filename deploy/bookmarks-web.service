# systemd user unit for the bookmarks web server (capture API + console).
# Installed and restarted by scripts/deploy.sh; it runs the `bookmarks` uv
# tool, never a clone (ADR 0003). First time: systemctl --user enable bookmarks-web
[Unit]
Description=bookmarks web server
After=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/bookmarks/env
ExecStart=%h/.local/bin/bookmarks serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
